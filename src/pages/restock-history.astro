---
import RestockHistoryView from "../components/RestockHistory.jsx";
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Halaman histori restok obat dan upload data historis"
    />
    <title>Historis Restok - PrediksiRestockObat</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📊</text></svg>"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #030712;
        color: #e5e7eb;
        font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>

  <body>
    <RestockHistoryView client:load />
  </body>
</html>
