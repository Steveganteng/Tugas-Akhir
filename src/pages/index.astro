---
// Memanggil komponen React 
import Dashboard from '../components/Dashboard.jsx';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Dashboard prediksi kebutuhan obat Klinik Del menggunakan model Hybrid SARIMAâ€“Holt-Winters" />
    <title>PrediksiRestockObat â€” Klinik Del</title>

    <!-- Favicon sederhana berbasis emoji -->
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20100%20100%22%3E%3Ctext%20y=%22.9em%22%20font-size=%2290%22%3E%3C/text%3E%3C/svg%3E" />

    <style>
      /* Reset & base */
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        height: 100%;
        background: linear-gradient(180deg, #f7fffe 0%, #f6fbff 50%, #ffffff 100%);
        color: #0f172a;
        font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
        overflow: auto;
      }

      /* Wrapper agar komponen React mengisi seluruh viewport */
      #app-root {
        width: 100vw;
        min-height: 100vh;
      }

      /* Skeleton / loading state sebelum React mount */
      .loading-screen {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        gap: 16px;
        background: linear-gradient(180deg, #f7fffe 0%, #f6fbff 50%, #ffffff 100%);
      }

      .loading-screen .spinner {
        width: 40px;
        height: 40px;
        border: 3px solid #dbeafe;
        border-top-color: #2f80ed;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }

      .loading-screen p {
        font-size: 13px;
        color: #64748b;
        letter-spacing: 1px;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }
    </style>
  </head>

  <body>
    <div id="app-root">
      <Dashboard client:load />
    </div>
  </body>
</html>

